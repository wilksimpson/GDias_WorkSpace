#line 1 "c:/TOTVS/TDS/Include_P12\stdwin.ch"
#line 14 "rwmake.ch"
#line 21 "c:\TOTVS\TDS\Workspace\Gdias - Lobo\transdourada\compras\relatorio\\c:/TOTVS/TDS/Workspace/Gdias - Lobo/transdourada/compras/relatorio/COMREL04.PRW"
Function U_COMREL04






Local cDesc1         := "Este programa tem como objetivo imprimir relatorio "
Local cDesc2         := "de acordo com os parametros informados pelo usuario."
Local cDesc3         := "A situação das NF-e"
Local cPict          := ""
Local titulo         := "Manifestação de NF-e"
Local nLin           := 80
Local Cabec1         := ""
Local Cabec2         := ""
Local imprime        := .T. 
Local aOrd           := {}

Private lEnd         := .F. 
Private lAbortPrint  := .F. 
Private CbTxt        := ""
Private limite       := 132
Private tamanho      := "M"
Private nomeprog     := "COMREL04"
Private nTipo        := 18
Private aReturn      := { "Zebrado", 1, "Administracao", 2, 2, 1, "", 1}
Private nLastKey     := 0
Private cbtxt        := Space(10)
Private cbcont       := 00
Private CONTFL       := 01
Private m_pag        := 01
Private wnrel        := "COMREL04"
Private cPerg        := "COMREL04"+Space(2)
Private cString      := ""

dbSelectArea("C00")
dbSetOrder(1)

VerSX1(cPerg)

pergunte(cPerg, .f. )

wnrel := SetPrint(cString,NomeProg,cPerg,@titulo,cDesc1,cDesc2,cDesc3, .T. ,aOrd, .T. ,Tamanho,, .T. )

If nLastKey == 27
	Return
Endif

SetDefault(aReturn,cString)

If nLastKey == 27

   Return
Endif

nTipo := If(aReturn[4]==1,15,18)

If Select("QryC00") > 0

   QryC00->(DbCloseArea())
Endif


cQuery := " "
cQuery += " SELECT C00_FILIAL,C00_STATUS, C00_CHVNFE,C00_SERNFE, C00_NUMNFE,C00_VLDOC, C00_CNPJEM, C00_NOEMIT,C00_DTEMI, C00_CODRET,C00_DESRES "
cQuery += " FROM "+RetSqlName("C00") + " C00 "
cQuery += " WHERE D_E_L_E_T_ =' '"
cQuery += "   AND C00_FILIAL BETWEEN '"+MV_PAR03+"' AND '" + MV_PAR04 + "'"
cQuery += "   AND C00_DTEMI  BETWEEN '"+Dtos(MV_PAR01)+"' AND '" + DTOS(MV_PAR02) + "'"
cQuery += " ORDER BY C00_FILIAL, C00_STATUS, C00_DTEMI,C00_CHVNFE "
dbUseArea( .T. ,"TOPCONN",TCGenQry(,,cQuery),"QryC00", .F. , .T. )



Titulo := Alltrim(Titulo) + " Data de Emissao "+Dtoc(MV_PAR01)+" a "+ Dtoc(MV_PAR02)







   Processa( {|| RunProc(Titulo) } )


Return


Static Function RunProc(cTitulo)

Local _nValFil := 0
Local _nValTot := 0
Local _cDes
Local _cFil    := Space(2)
Local cPasta
Local cArq := "COMREL04.csv"
Local aExcel := {}

aAdd(aExcel, {cTitulo})
aAdd(aExcel, {"Relatório emitido em "+DTOC(Date())+" por "+AllTrim(cUsername)})
aAdd(aExcel, {"Período: "+DTOC(MV_PAR01)+" até "+DTOC(MV_PAR02)})
aAdd(aExcel, {"Filial de: "+MV_PAR03+" até "+MV_PAR04})
aAdd(aExcel, {"Notas de: Entrada"})








aAdd(aExcel, {""})


aAdd(aExcel,{"Filial","Status","Data Emis","Num Nf-e","Serie","CNPJ Emitente","Nome Do Emitente","Valor Nfe","Cod Processo SEFA","Desc Processo Sefa","Chave NFe"} )

PswOrder(1)

If PswSeek(__cUserId, .T. )

	cPasta := AllTrim(PswRet()[2][3])
EndIf

If !MontaDir(cPasta)

	cPasta := "C:\SPOOL"

	If !MontaDir(cPasta)


		Alert("Impossível gerar o arquivo destino." + chr(13) + chr(10) + "Contate o suporte técnico.")
		Return Nil
	EndIf
Endif

cArq := cPasta + "\" + cArq

DbSelectArea("QryC00")
DbGotop()

_cFil := QryC00->C00_FILIAL

while !EOF()

   If _cFil <>  QryC00->C00_FILIAL


      aAdd(aExcel, { "Total da Filial "+_cFil,"","","",_nValFil,"","","","","",""})

      _cFil := QryC00->C00_FILIAL

  	  _nValFil := 0
   Endif

   Do Case

      Case  QryC00->C00_STATUS = "0"

            _cDes := "Sem Status"

      Case  QryC00->C00_STATUS = "1"

            _cDes := "Operação Confirmada"

	  Case  QryC00->C00_STATUS = "2"

            _cDes := "Desconhecimento da Operação"

      Case  QryC00->C00_STATUS = "3"

            _cDes := "Operação não Realizada"

      Case  QryC00->C00_STATUS = "4"

            _cDes := "Ciencia da Operação"

      OtherWise

           _cDes := "Status Ignorado"
   EndCase





   aAdd(aExcel, { QryC00->C00_FILIAL,QryC00->C00_STATUS+" "+_cDes,Stod(QryC00->C00_DTEMI), QryC00->C00_SERNFE,QryC00->C00_NUMNFE,QryC00->C00_CNPJEM,QryC00->C00_NOEMIT, QryC00->C00_VLDOC,QryC00->C00_CODRET,QryC00->C00_DESRES,QryC00->C00_CHVNFE })

   _nValTot := _nValTot + QryC00->C00_VLDOC
   _nValFil := _nValFil + QryC00->C00_VLDOC

  DbSkip()
Enddo


aAdd(aExcel, { "Total da Filial "+_cFil,"","","",_nValFil,"","","","","",""})

aAdd(aExcel, { "Total da Geral "       ,"","","",_nValTot,"","","","","",""})

If Len(aExcel) >= 2

	cRet := U_MyArrCsv(aExcel, cArq, Nil, cTitulo)

	If !Empty(cRet)

		Alert(cRet)
	EndIf
Else

   Alert("Dados dos parametros não encontrados")
Endif

Return Nil










Static Function RunReport(Cabec1,Cabec2,cTitulo,nLin,_cTp)

Local _nValTot := 0
Local _nValFil := 0
Local _nValTor := 0
Local _nValFor := 0
Local _nVl     := 0
Local _nVlGro  := 0
Local _nVlGrd  := 0
Local _cFil    := Space(2)
Local _cGrp    := Space(2)


DbSelectArea("QrySn4")
DbGotop()

SetRegua(RecCount())

_cFil := QrySn4->FILIAL

while !EOF()

   If lAbortPrint

  	   PrintOut(nLin,00,"*** CANCELADO PELO OPERADOR ***",)
     	Exit
   Endif

  	If nLin > 71 .or.  _cFil <> QrySn4->FILIAL

     	If _cFil <>  QrySn4->FILIAL

        	nLin := nLin + 1
         PrintOut(nLin,014,"Total da Filial "+_cFil,)
  	      PrintOut(nLin,082,Transform(_nValFor,"@E ,999,999,999.99"),)
     	   PrintOut(nLin,105,Transform(_nValFil,"@E 99,999,999.99"),)
        	PrintOut(nLin,119,Transform((_nValFor-_nValFil),"@E 99,999,999.99"),)

         _cFil := QrySn4->FILIAL

  	      _nValFil := 0
     	   _nValFor := 0
      Endif











  	   Cabec1 := "Fl  Cod Bem   Item           Descrição            Data Aquis        Conta           Valor Ori    Tx Depr Depr Acumu.   Valor Contab "

     	Cabec(cTitulo,Cabec1,Cabec2,NomeProg,Tamanho,nTipo)
      nLin := 8
  	Endif

   _nVl := Posicione("SN3",1,QrySn4->FILIAL+QrySn4->CODIGO+QrySn4->ITEM+"01","N3_VORIG1")

  	PrintOut(nLin,000,QrySn4->FILIAL,)
   PrintOut(nLin,003,QrySn4->CODIGO,)
  	PrintOut(nLin,014,QrySn4->ITEM,)
   PrintOut(nLin,019,Substr(Posicione("SN1",1,QrySn4->FILIAL+QrySn4->CODIGO+QrySn4->ITEM,"N1_DESCRIC"),1,30),)
  	PrintOut(nLin,050,Posicione("SN1",1,QrySn4->FILIAL+QrySn4->CODIGO+QrySn4->ITEM,"N1_AQUISIC"),)
   PrintOut(nLin,061,Posicione("SN3",1,QrySn4->FILIAL+QrySn4->CODIGO+QrySn4->ITEM+"01","N3_CDEPREC"),)






   PrintOut(nLin,082,Transform(_nVl,"@E 999,999,999.99"),)
  	PrintOut(nLin,097,Transform(Posicione("SN3",1,QrySn4->FILIAL+QrySn4->CODIGO+QrySn4->ITEM+"01","N3_TXDEPR1"),"@E 99.9999"),)
   PrintOut(nLin,105,Transform(VAL_DEP,"@E 99,999,999.99"),)
  	PrintOut(nLin,119,Transform((_nVl-VAL_DEP),"@E 99,999,999.99"),)

   nLin := nLin + 1

  	_nValTot := _nValTot + VAL_DEP
   _nValFil := _nValFil + VAL_DEP
  	_nVlGrd  := _nVlGrd  + VAL_DEP

   _nValTor := _nValTor + _nVl
  	_nValFor := _nValFor + _nVl
   _nVlGro  := _nVlGro  + _nVl

  	_cGrp := Substr(QrySn4->CODIGO,1,2) + " - " + Posicione("SNG",1,xFilial("SNG") + Substr(QrySn4->CODIGO,1,2)+Space(2),"NG_DESCRIC")

  	DbSkip()

   If _cGrp <> Substr(QrySn4->CODIGO,1,2)

  	   nLin := nLin + 1
     	PrintOut(nLin,014,"Total do Grupo "+_cGrp,)
		PrintOut(nLin,082,Transform(_nVlGro,"@E 999,999,999.99"),)
		PrintOut(nLin,105,Transform(_nVlGrd,"@E 99,999,999.99"),)
		PrintOut(nLin,119,Transform((_nVlGro-_nVlGrd),"@E 99,999,999.99"),)
		nLin := nLin + 2

		_nVlGro  := 0
  	   _nVlGrd  := 0
	Endif
EndDo

nLin := nLin + 1
PrintOut(nLin,014,"Total da Filial "+_cFil,)
PrintOut(nLin,082,Transform(_nValFor,"@E 999,999,999.99"),)
PrintOut(nLin,105,Transform(_nValFil,"@E 99,999,999.99"),)
PrintOut(nLin,119,Transform((_nValFor-_nValFil),"@E 99,999,999.99"),)
nLin := nLin + 2

PrintOut(nLin,014,"Total da Geral ",)
PrintOut(nLin,082,Transform(_nValTor,"@E 999,999,999.99"),)
PrintOut(nLin,105,Transform(_nValTot,"@E 99,999,999.99"),)
PrintOut(nLin,119,Transform((_nValTor-_nValTot),"@E 99,999,999.99"),)


Set( 20, "SCREEN" )





If aReturn[5]==1
   dbCommitAll()
   Set( 24, "" )
   OurSpool(wnrel)
Endif

MS_FLUSH()

Return

Static Function VerSX1(_cPer)


Private cAlias:=Alias(),aPerg := {}

aRegs := {}

AADD(aRegs,{_cPer,"01","Emissao de ?   " ,"Emissao de            ?","Emissao de            ?","mv_ch1","D",08,0,0,"G","naovazio","mv_par01","   ","","","","","   ","","","","","","","","","","","","","","","","","","","",""})
AADD(aRegs,{_cPer,"02","Emissao Ate ?  " ,"Emissao ate           ?","Emissao ate           ?","mv_ch2","D",08,0,0,"G","naovazio","mv_par02","   ","","","","","   ","","","","","","","","","","","","","","","","","","","",""})
AADD(aRegs,{_cPer,"03","Filial de  ?   " ,"Filial de             ?","Filial de             ?","mv_ch3","C",02,0,0,"G","        ","mv_par03","   ","","","","","   ","","","","","","","","","","","","","","","","","","","XM0",""})
AADD(aRegs,{_cPer,"04","Filial Ate ?   " ,"Filial Ate            ?","Filial Ate            ?","mv_ch4","C",02,0,0,"G","naovazio","mv_par04","   ","","","","","   ","","","","","","","","","","","","","","","","","","","XM0",""})


DbSelectArea("SX1")
DbSetOrder(1)
DbGotop()

For I:=1 to Len(aRegs)
    If !DBSeek(cPerg+aRegs[i,2])

       RecLock("SX1", .T. )

       For j:=1 to Len(aRegs[i])

           FieldPut(j,aRegs[i,j])
      Next
      MsUnlock()
   Endif
Next

DBSelectArea(cAlias)

Return
